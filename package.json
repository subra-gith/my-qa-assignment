{
  "name": "my-qa-assignment",
  "version": "1.0.0",
  "description": "Playwright UI and API test suite for saucedemo.com and reqres.in",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:video": "VIDEO=on playwright test --project=ui",
    "test:debug": "playwright test --project=ui --debug",
    "ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2"
  }
}
